# Production-only configuration. Copy to .env.production and replace every placeholder.
POSTGRES_DB=time_manager
POSTGRES_USER=time_manager
POSTGRES_PASSWORD=replace_with_a_long_url_safe_random_password
POSTGRES_PORT=5432
BACKEND_PORT=3001
FRONTEND_PORT=3000
HTTP_PORT=8080
HTTP_BIND_ADDRESS=0.0.0.0

BETTER_AUTH_SECRET=replace_with_at_least_32_random_characters
BETTER_AUTH_URL=https://api.example.com
FRONTEND_URL=https://your-app.vercel.app
BACKEND_URL=https://api.example.com
