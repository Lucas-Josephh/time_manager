{
  "info": {
    "name": "Tempo — API locale",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Collection issue des contrôleurs et DTO du projet. Renseigner email/password, puis lancer Connexion email. Authentification par cookies gérés par Postman, sans Bearer token. frontendOrigin doit correspondre à FRONTEND_URL. Les créations mémorisent les identifiants. Les droits dépendent du compte connecté. Les suppressions et modifications changent les données : exécuter les requêtes individuellement, pas la collection complète."
  },
  "auth": {
    "type": "noauth"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3001/api",
      "type": "string"
    },
    {
      "key": "frontendOrigin",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "email",
      "value": "",
      "type": "string"
    },
    {
      "key": "password",
      "value": "",
      "type": "string"
    },
    {
      "key": "newPassword",
      "value": "",
      "type": "string"
    },
    {
      "key": "temporaryPassword",
      "value": "",
      "type": "string"
    },
    {
      "key": "newUserEmail",
      "value": "alice.postman@example.com",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "",
      "type": "string"
    },
    {
      "key": "organizationId",
      "value": "",
      "type": "string"
    },
    {
      "key": "parentOrganizationId",
      "value": "",
      "type": "string"
    },
    {
      "key": "teamId",
      "value": "",
      "type": "string"
    },
    {
      "key": "sourceTeamId",
      "value": "",
      "type": "string"
    },
    {
      "key": "managerId",
      "value": "",
      "type": "string"
    },
    {
      "key": "scheduleId",
      "value": "",
      "type": "string"
    },
    {
      "key": "rootScheduleId",
      "value": "",
      "type": "string"
    }
  ],
