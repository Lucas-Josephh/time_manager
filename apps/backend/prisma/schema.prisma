generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum ScheduleType {
  FIXED
  FLEXIBLE
  SEMI_FLEXIBLE
}

enum ExpectedPeriod {
  DAY
  WEEK
  MONTH
}

model WorkPolicy {
  id              String         @id @default(uuid())
  name            String
  minBreakMinutes Int
  maxBreakMinutes Int?
  isActive        Boolean        @default(true)
  scheduleType    ScheduleType
  expectedMinutes Int
  expectedPeriod  ExpectedPeriod
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  users         User[]
  teams         Team[]
  organizations Organization[]
  settings      WorkPolicySettings[]

  @@map("work_policy")
}

// The application uses the single settings record with id "global".
model WorkPolicySettings {
  id                  String     @id @default("global")
  defaultWorkPolicyId String
  defaultWorkPolicy   WorkPolicy @relation(fields: [defaultWorkPolicyId], references: [id], onDelete: Restrict)

  @@index([defaultWorkPolicyId])
  @@map("work_policy_settings")
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parentId String?
  parent   Organization?  @relation("OrganizationHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children Organization[] @relation("OrganizationHierarchy")

  managerId String?
  manager   User?   @relation("OrganizationManager", fields: [managerId], references: [id], onDelete: SetNull)

  teams Team[]
  users User[] @relation("OrganizationMembers")

  workPolicyId String?
  workPolicy   WorkPolicy? @relation(fields: [workPolicyId], references: [id], onDelete: SetNull)

  @@index([workPolicyId])
  @@index([parentId])
  @@index([managerId])
  @@map("organization")
}

model Team {
  id   String @id @default(uuid())
  name String @unique

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  managerId String?
  manager   User?   @relation("TeamManager", fields: [managerId], references: [id], onDelete: SetNull)

  members User[] @relation("TeamMembers")

  workPolicyId String?
  workPolicy   WorkPolicy? @relation(fields: [workPolicyId], references: [id], onDelete: SetNull)

  @@index([workPolicyId])
  @@index([organizationId])
  @@index([managerId])
  @@map("team")
}

model User {
  id            String   @id
  firstname     String
  lastname      String
  email         String
  phone         String?
  isAdmin       Boolean  @default(false)
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions Session[]
  accounts Account[]

  organizationId String?
  organization   Organization? @relation("OrganizationMembers", fields: [organizationId], references: [id], onDelete: SetNull)

  managedOrganizations Organization[] @relation("OrganizationManager")

  teamId String?
  team   Team?   @relation("TeamMembers", fields: [teamId], references: [id], onDelete: Restrict)

  managedTeams Team[] @relation("TeamManager")

  workPolicyId String?
  workPolicy   WorkPolicy? @relation(fields: [workPolicyId], references: [id], onDelete: SetNull)

  @@unique([email])
  @@index([workPolicyId])
  @@index([organizationId])
  @@index([teamId])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}
