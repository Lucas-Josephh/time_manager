    {
      "name": "02 — Authentification",
      "item": [
        {
          "name": "Connexion email",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Origin",
                "value": "{{frontendOrigin}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/sign-in/email",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "sign-in",
                "email"
              ]
            },
            "description": "Utiliser un compte existant. Postman conserve automatiquement le cookie de session. Aucune inscription publique.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Session courante",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
