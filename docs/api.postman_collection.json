            "url": {
              "raw": "{{baseUrl}}/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users"
              ]
            },
            "description": "Enregistre userId. Le compte devra changer son mot de passe à sa première connexion. teamId est facultatif.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstname\": \"Alice\",\n  \"lastname\": \"Martin\",\n  \"email\": \"{{newUserEmail}}\",\n  \"password\": \"{{temporaryPassword}}\",\n  \"isAdmin\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  const data = pm.response.json().data;",
                  "  if (data && data.id) pm.collectionVariables.set(\"userId\", data.id);",
                  "}"
                ]
              }
            }
          ]
        },
