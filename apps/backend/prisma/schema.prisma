generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model WorkSchedule {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdByUserId String
  createdBy       User   @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)

  usersAssignments         UserWorkScheduleAssignment[]
  teamsAssignments         TeamWorkScheduleAssignment[]
  organizationsAssignments OrganizationWorkScheduleAssignment[]

  versions WorkScheduleVersion[]

  @@map("work_schedule")
}

model WorkScheduleVersion {
  id             String   @id @default(uuid())
  workScheduleId String
  version        Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  createdByUserId String
  createdBy       User   @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)

  workSchedule WorkSchedule  @relation(fields: [workScheduleId], references: [id], onDelete: Restrict)
  days         ScheduleDay[]
  workSessions WorkSession[]

  @@unique([workScheduleId, version])
  @@map("work_schedule_version")
}

model ScheduleDay {
  id                    String    @id @default(uuid())
  workScheduleVersionId String
  dayOfWeek             DayOfWeek

  workScheduleVersion WorkScheduleVersion @relation(fields: [workScheduleVersionId], references: [id], onDelete: Restrict)

  timeSlots TimeSlot[]

  @@unique([workScheduleVersionId, dayOfWeek])
  @@map("schedule_day")
}

/**
 * Represents the assignment of a work schedule to a user.
 * - One user can be associate with same multiple work schedule
 * - One user can be associate to any work schedule
 */
model UserWorkScheduleAssignment {
  id             String       @id @default(uuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  workScheduleId String
  workSchedule   WorkSchedule @relation(fields: [workScheduleId], references: [id], onDelete: Restrict)
  effectiveFrom  DateTime     @default(now())

  @@unique([userId, effectiveFrom])
  @@map("user_work_schedule_assignment")
}

model TeamWorkScheduleAssignment {
  id             String       @id @default(uuid())
  teamId         String
  team           Team         @relation(fields: [teamId], references: [id], onDelete: Restrict)
  workScheduleId String
  workSchedule   WorkSchedule @relation(fields: [workScheduleId], references: [id], onDelete: Restrict)
  effectiveFrom  DateTime     @default(now())

  @@unique([teamId, effectiveFrom])
  @@map("team_work_schedule_assignment")
}

model OrganizationWorkScheduleAssignment {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  workScheduleId String
  workSchedule   WorkSchedule @relation(fields: [workScheduleId], references: [id], onDelete: Restrict)
  effectiveFrom  DateTime     @default(now())

  @@unique([organizationId, effectiveFrom])
  @@map("organization_work_schedule_assignment")
}

model TimeSlot {
  id            String @id @default(uuid())
  scheduleDayId String
  startTime     String
  endTime       String

  scheduleDay ScheduleDay @relation(fields: [scheduleDayId], references: [id], onDelete: Restrict)

  @@index([scheduleDayId])
  @@map("time_slot")
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parentId String?
  parent   Organization?  @relation("OrganizationHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children Organization[] @relation("OrganizationHierarchy")

  managerId String?
  manager   User?   @relation("OrganizationManager", fields: [managerId], references: [id], onDelete: SetNull)

  teams Team[]
  users User[] @relation("OrganizationMembers")

  workScheduleAssignments OrganizationWorkScheduleAssignment[]

  @@index([parentId])
  @@index([managerId])
  @@map("organization")
}

model Team {
  id   String @id @default(uuid())
  name String @unique

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  managerId String?
  manager   User?   @relation("TeamManager", fields: [managerId], references: [id], onDelete: SetNull)

  members User[] @relation("TeamMembers")

  workScheduleAssignments TeamWorkScheduleAssignment[]

  @@index([organizationId])
  @@index([managerId])
  @@map("team")
}

model User {
  id                 String   @id
  name               String
  firstname          String
  lastname           String
  email              String
  job                String?
  phone              String?
  isAdmin            Boolean  @default(false)
  mustChangePassword Boolean  @default(false)
  emailVerified      Boolean  @default(false)
  image              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  sessions Session[]
  accounts Account[]

  // A user can be associated to a single organization
  organizationId String?
  organization   Organization? @relation("OrganizationMembers", fields: [organizationId], references: [id], onDelete: SetNull)

  // A user can manage multiple organizations
  managedOrganizations Organization[] @relation("OrganizationManager")

  // A user can be a member of a single team
  teamId String?
  team   Team?   @relation("TeamMembers", fields: [teamId], references: [id], onDelete: Restrict)

  // A user can manager multiple teams (disclaimer: manager != member)
  managedTeams Team[] @relation("TeamManager")

  // A user can make multiple work session to store their work timee
  workSessions WorkSession[]

  // A user can create multiple work schedule
  workSchedules WorkSchedule[]

  // A user can create multiple variant of work schedule with differents hours
  workScheduleVersions WorkScheduleVersion[]

  // A user can be assigned to a multiple work schedules
  workScheduleAssignments UserWorkScheduleAssignment[]

  @@unique([email])
  @@index([organizationId])
  @@index([teamId])
  @@map("user")
}

model WorkSession {
  id        String    @id @default(uuid())
  userId    String
  startedAt DateTime
  endedAt   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  workScheduleVersionId String
  workScheduleversion   WorkScheduleVersion @relation(fields: [workScheduleVersionId], references: [id], onDelete: Restrict)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, startedAt])
  @@map("work_session")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}
