{
  "name": "time-manager",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": "^24.9.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "prisma:generate": "pnpm --filter backend prisma:generate",
    "prisma:migrate": "pnpm --filter backend prisma:migrate",
    "prisma:db:seed": "pnpm --filter backend exec prisma db seed",
    "prisma:studio": "pnpm --filter backend prisma:studio",
    "prisma:db:push": "pnpm --filter backend exec prisma migrate deploy",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:cov": "turbo run test:cov"
  },
  "devDependencies": {
    "prettier": "3.9.9",
    "turbo": "2.11.7"
  },
  "dependencies": {
    "antd": "^6.6.5",
    "@better-auth/i18n": "^1.7.7"
  }
}
