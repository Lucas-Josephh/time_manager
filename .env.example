# Local development values only. Production must use .env.production.
POSTGRES_DB=time_manager
POSTGRES_USER=time_manager
POSTGRES_PASSWORD=local_development_only
# Used by the backend and Prisma when running on the host.
# Compose builds its internal DATABASE_URL from the POSTGRES_* values above.
# URL-encode credentials in DATABASE_URL; use URL-safe POSTGRES_* values in Compose.
DATABASE_URL=postgresql://time_manager:local_development_only@localhost:5432/time_manager
HTTP_PORT=8080
# Local-only ports for the database and application containers.
POSTGRES_PORT=5432
BACKEND_PORT=3001
FRONTEND_PORT=3000

BETTER_AUTH_SECRET=replace_with_a_random_secret_at_least_32_characters
BETTER_AUTH_URL=http://localhost:8080
FRONTEND_URL=http://localhost:8080
BACKEND_URL=http://backend:3001
# Microsoft Entra app credentials. Leave all three empty to disable Microsoft.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=

# Seeders (if you want create a default users)
#SEED_ADMIN_EMAIL=admin@tempoo.fr
#SEED_ADMIN_PASSWORD=Pa$$w0rd42
